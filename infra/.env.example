# Name used before the Super Admin sets branding in Settings
APP_NAME=AdStudio
# SES sender for download-link emails; SES sends a verification email on deploy (optional)
# SENDER_EMAIL=ads@example.com
# Where Claude runs:
#   bedrock         Claude 5.x on Bedrock (Haiku 5.5 scans, Sonnet 5.5 copy); needs model access
#   bedrock-legacy  Claude 4.x on Bedrock (Haiku 4.5 scans, Sonnet 4.6 copy)
#   anthropic       Claude API, key in SSM (npm run claude:key)
# CLAUDE_PROVIDER=bedrock
# Budget and alarm emails (optional; you confirm the SNS subscription by email)
# ALERT_EMAIL=you@example.com
# AWS WAF on CloudFront and Cognito sign-in, about $10-18 a month (set false to turn off)
# WAF=true
# Parallel renders per export, 1-8; keep 4 or lower while the account's Lambda concurrency limit is 10
# RENDER_CONCURRENCY=4
# Custom domain (all three, or none); the hosted zone must be in this account
# DOMAIN_NAME=ads.example.com
# HOSTED_ZONE_ID=Z0123456789
# HOSTED_ZONE_NAME=example.com
