# Name used before the Super Admin sets branding in Settings
APP_NAME=AdStudio
# SES sender for download-link emails; SES sends a verification email on deploy (optional)
# SENDER_EMAIL=ads@example.com
# Where Claude runs:
#   bedrock         Claude 5.x on Bedrock (Haiku 5.5 scans, Sonnet 5.5 copy); needs model access
#   bedrock-legacy  Claude 4.x on Bedrock (Haiku 4.5 scans, Sonnet 4.6 copy)
#   anthropic       Claude API, key in SSM (npm run claude:key)
# CLAUDE_PROVIDER=bedrock
